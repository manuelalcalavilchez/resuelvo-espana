<!DOCTYPE html>
<html lang="<%= t.lang %>" dir="<%= t.dir %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= t.city_title %>
      <%= ciudad %> | Queens
  </title>
  <meta name="description" content="<%= t.city_title %> <%= ciudad %>. Queens.">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-velvet">

  <!-- Navbar -->
  <nav class="navbar">
    <a href="/inicio" class="navbar-logo" style="text-decoration:none">
      <img src="/img/queens-logo.png" alt="Queens" style="height:36px;"
        onerror="this.outerHTML='<span class=&quot;gold-shimmer&quot;>QUEENS</span>'">
    </a>
    <div class="navbar-links">
      <a href="/inicio">
        <%= t.city_back %>
      </a>
    </div>
  </nav>

  <div class="container" style="padding-top:100px;padding-bottom:60px;">
    <div id="recompensa-banner"
      style="position:sticky;top:70px;z-index:20;margin-bottom:12px;background:#111;border:1px solid #d5a03d;padding:10px 14px;border-radius:10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
      <span class="badge">Programa de afiliadas</span>
      <span style="flex:1;min-width:200px;">Trae anunciantes y gana días gratis: <strong>1</strong>→7 días ·
        <strong>3</strong>→15 días · <strong>5</strong>→30 días + Corona 👑</span>
      <button type="button" id="banner-close"
        style="background:none;border:none;color:#aaa;font-size:18px;cursor:pointer;">×</button>
    </div>

    <!-- City Header -->
    <div style="text-align:center;margin-bottom:40px;">
      <p class="section-title">
        <%= t.city_title %>
      </p>
      <h1 class="gold-shimmer font-cinzel" style="font-size:clamp(2rem,5vw,3.5rem);margin-bottom:8px;">
        <%= ciudad.toUpperCase() %>
      </h1>
    </div>

    <!-- Filter Bar -->
    <form id="geoForm" method="GET" action="/ciudad/<%= ciudad %>">
      <div class="filter-bar">
        <select name="categoria" class="filter-select auto-submit-select">
          <option value="">
            <%= t.city_filter_all %>
          </option>
          <option value="chica" <%=filters.categoria==='chica' ?'selected':'' %>><%= t.cat_chica %>
          </option>
          <option value="chico" <%=filters.categoria==='chico' ?'selected':'' %>><%= t.cat_chico %>
          </option>
          <option value="trans" <%=filters.categoria==='trans' ?'selected':'' %>><%= t.cat_trans %>
          </option>
        </select>
        <select name="disponibilidad" class="filter-select auto-submit-select">
          <option value="">Todas las disponibilidades</option>
          <option value="disponible" <%=filters.disponibilidad==='disponible' ?'selected':'' %>>🟢 Disponible ahora
          </option>
          <option value="proximamente" <%=filters.disponibilidad==='proximamente' ?'selected':'' %>>🟡 Próximamente
          </option>
          <option value="no_disponible" <%=filters.disponibilidad==='no_disponible' ?'selected':'' %>>🔴 No disponible
          </option>
        </select>
        <button type="submit" class="filter-btn">Buscar</button>
        <a href="/ciudad/<%= ciudad %>" style="font-size:0.75rem;color:var(--text-muted);padding:10px;">Limpiar
          filtros</a>
        <% let _cercLabel='Más cercanas' ; if (filters.categoria==='chica' ) _cercLabel='Chicas más cercanas' ; else if
          (filters.categoria==='chico' ) _cercLabel='Chicos más cercanos' ; else if (filters.categoria==='trans' )
          _cercLabel='Trans más cercanas' ; %>
          <button type="button" id="btn-cercanas" class="filter-btn" style="background:#0a8d54;">
            <%= _cercLabel %>
          </button>
          <input type="hidden" name="lat" value="<%= filters.lat || '' %>">
          <input type="hidden" name="lng" value="<%= filters.lng || '' %>">
          <input type="hidden" name="max_km" value="<%= filters.max_km || '' %>">
      </div>
    </form>

    <!-- 🟡 DESTACADAS 🟡 -->
    <% if (destacadas.length> 0) { %>
      <div class="tier-header">
        <span class="tier-badge destacada">👑 Destacadas</span>
      </div>
      <div class="profiles-grid highlighted">
        <% destacadas.forEach(p=> { %>
          <a href="/perfil/<%= p.id %>" class="profile-card highlighted-card"
             data-fotos="<%- JSON.stringify(p.fotos) %>" data-idx="0">
            <span class="card-plan-badge destacada"></span>
            <div class="availability-dot <%= p.disponibilidad %>"></div>
            <% if (p.fotos.length > 0) { %>
              <img class="card-image cd-img" src="<%= p.fotos[0] %>" alt="<%= p.nombre %>" loading="lazy">
            <% } else { %>
              <div class="card-image-placeholder"><%= p.nombre.charAt(0).toUpperCase() %></div>
            <% } %>
            <% if (p.fotos.length > 1) { %>
              <button class="cd-arrow cd-prev" onclick="cdNav(event,this,-1)">&#8249;</button>
              <button class="cd-arrow cd-next" onclick="cdNav(event,this,+1)">&#8250;</button>
            <% } %>
            <button class="cd-expand" onclick="cdExpand(event,this)" title="Ampliar">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </button>
            <div class="card-overlay">
              <div class="card-name">
                <% if (p.nacionalidad) { %><img src="https://flagcdn.com/<%= p.nacionalidad %>.svg" alt="" style="width:18px;height:13px;border-radius:2px;vertical-align:middle;margin-right:4px;"><% } %>
                <%= p.nombre %>
              </div>
              <div class="card-meta">
                <%= p.edad ? p.edad + ' años' : '' %><%= p.edad && p.zona ? ' · ' : '' %><%= p.zona || '' %>
              </div>
              <% if (p.distancia !== undefined) { %>
                <div class="badge" style="margin-top:6px;">A <%= p.distancia %> km</div>
              <% } %>
            </div>
          </a>
        <% }) %>
      </div>
      <% } %>

        <!-- 🟡 BÁSICAS 🟡 -->
        <% if (basicas.length> 0) { %>
          <div class="tier-header">
            <span class="tier-badge basica">Catálogo</span>
          </div>
          <div class="profiles-grid basic-grid">
            <% basicas.forEach(p=> { %>
              <a href="/perfil/<%= p.id %>" class="profile-card">
                <div class="availability-dot <%= p.disponibilidad %>"></div>
                <% if (p.nacionalidad) { %>
                  <img src="https://flagcdn.com/<%= p.nacionalidad %>.svg" alt="<%= p.nacionalidad %>" style="position:absolute;top:8px;right:8px;width:24px;height:17px;border-radius:2px;z-index:2;box-shadow:0 1px 4px rgba(0,0,0,0.4);">
                <% } %>
                <% if (p.fotos.length> 0) { %>
                  <img class="card-image" src="<%= p.fotos[0] %>" alt="<%= p.nombre %>" loading="lazy">
                  <% } else { %>
                    <div class="card-image-placeholder" style="font-size:1.5rem">
                      <%= p.nombre.charAt(0).toUpperCase() %>
                    </div>
                    <% } %>
                      <div class="card-overlay">
                        <div class="card-name" style="font-size:0.9rem">
                          <% if (p.nacionalidad) { %><img src="https://flagcdn.com/<%= p.nacionalidad %>.svg" alt="" style="width:16px;height:11px;border-radius:2px;vertical-align:middle;margin-right:3px;"><% } %>
                          <%= p.nombre %>
                        </div>
                        <div class="card-meta">
                          <%= p.edad ? p.edad + ' años' : '' %><%= p.edad && p.zona ? ' · ' : '' %><%= p.zona || '' %>
                        </div>
                        <% if (p.distancia !==undefined) { %>
                          <div class="badge" style="margin-top:6px;">A <%= p.distancia %> km</div>
                          <% } %>
                      </div>
              </a>
              <% }) %>
          </div>
          <% } %>

            <!-- 🟡 AGENCIAS 🟡 -->
            <% if (agencias.length> 0) { %>
              <div class="tier-header">
                <span class="tier-badge basica">🏢 Agencias y Chalets</span>
              </div>
              <% agencias.forEach(a=> { %>
                <div class="agency-card">
                  <h3 class="gold-text font-cinzel-sm" style="font-size:1.1rem;margin-bottom:6px;">
                    <%= a.nombre %>
                  </h3>
                  <p class="text-muted mb-2">
                    <%= a.descripcion || '' %>
                  </p>
                  <% if (a.contacto) { %>
                    <a href="https://wa.me/<%= a.contacto.replace(/\D/g,'') %>" target="_blank"
                      class="btn btn-success btn-sm">
                      📱 Contactar por WhatsApp
                    </a>
                    <% } %>
                </div>
                <% }) %>
                  <% } %>


  </div>


  <!-- Ghost mode -->
  <a href="/ghost" class="ghost-trigger">● MODO SEGURO</a>

  <script src="/js/main.js"></script>
  <script>
    const btn = document.getElementById("btn-cercanas");
    if (btn) {
      btn.addEventListener("click", () => {
        if (!navigator.geolocation) return alert("Activa la ubicación");
        var GEO_KEY = 'queens_geo_consent';
        function doGeo() {
          localStorage.setItem(GEO_KEY, '1');
          navigator.geolocation.getCurrentPosition(pos => {
            document.querySelector("input[name=\"lat\"]").value = pos.coords.latitude.toFixed(5);
            document.querySelector("input[name=\"lng\"]").value = pos.coords.longitude.toFixed(5);
            document.querySelector("input[name=\"max_km\"]").value = 50;
            document.getElementById("geoForm").submit();
          }, () => alert("No pudimos obtener tu ubicación"));
        }
        if (localStorage.getItem(GEO_KEY) === '1') { doGeo(); }
        else if (confirm('📍 ¿Permitir acceder a tu ubicación para mostrarte perfiles cercanos?\n\nSe usa solo para calcular distancia. Datos anonimizados, máx. 90 días.\nMás info en /legal/privacidad')) { doGeo(); }
        else { localStorage.setItem(GEO_KEY, '0'); }
      });
    }
    const banner = document.getElementById("recompensa-banner");
    const closeBtn = document.getElementById("banner-close");
    if (banner && closeBtn) closeBtn.addEventListener("click", () => banner.style.display = "none");

    // Flechas en tarjetas destacadas
    window.cdNav = function(e, btn, dir) {
      e.preventDefault(); e.stopPropagation();
      var card = btn.closest('.profile-card');
      var fotos = JSON.parse(card.dataset.fotos || '[]');
      if (fotos.length < 2) return;
      var idx = ((parseInt(card.dataset.idx || 0) + dir + fotos.length) % fotos.length);
      card.dataset.idx = idx;
      var img = card.querySelector('.cd-img');
      img.style.transition = 'opacity 0.2s';
      img.style.opacity = '0';
      setTimeout(function() { img.src = fotos[idx]; img.style.opacity = '1'; }, 200);
    };

    // Botón ampliar → lightbox
    window.cdExpand = function(e, btn) {
      e.preventDefault(); e.stopPropagation();
      var card = btn.closest('.profile-card');
      var fotos = JSON.parse(card.dataset.fotos || '[]');
      var idx = parseInt(card.dataset.idx || 0);
      if (!fotos.length) return;
      lbOpen(fotos, idx);
    };

    // Lightbox global
    var lbFotos = [], lbIdx = 0;
    var lbEl = document.createElement('div');
    lbEl.innerHTML = [
      '<button id="lb-close" style="position:fixed;top:14px;right:18px;background:none;border:none;color:#bbb;font-size:2.2rem;cursor:pointer;z-index:10001;line-height:1;">✕</button>',
      '<button id="lb-prev" style="position:fixed;top:50%;left:14px;transform:translateY(-50%);background:rgba(0,0,0,0.6);border:1px solid rgba(212,175,55,0.45);color:#f9e27e;font-size:2rem;width:46px;height:46px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:10001;">&#8249;</button>',
      '<button id="lb-next" style="position:fixed;top:50%;right:14px;transform:translateY(-50%);background:rgba(0,0,0,0.6);border:1px solid rgba(212,175,55,0.45);color:#f9e27e;font-size:2rem;width:46px;height:46px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:10001;">&#8250;</button>',
      '<img id="lb-img" style="max-width:92vw;max-height:85vh;object-fit:contain;border-radius:10px;transition:opacity 0.25s;display:block;">',
      '<div id="lb-ctr" style="margin-top:12px;font-size:0.72rem;color:rgba(212,175,55,0.7);letter-spacing:2px;"></div>'
    ].join('');
    lbEl.style.cssText = 'display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.97);align-items:center;justify-content:center;flex-direction:column;';
    document.body.appendChild(lbEl);

    function lbShow(i) {
      lbIdx = ((i % lbFotos.length) + lbFotos.length) % lbFotos.length;
      var img = document.getElementById('lb-img');
      img.style.opacity = '0';
      setTimeout(function() { img.src = lbFotos[lbIdx]; img.style.opacity = '1'; }, 150);
      document.getElementById('lb-ctr').textContent = (lbIdx + 1) + ' / ' + lbFotos.length;
    }
    function lbOpen(fotos, idx) {
      lbFotos = fotos;
      lbEl.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      lbShow(idx);
    }
    function lbClose() { lbEl.style.display = 'none'; document.body.style.overflow = ''; }

    document.getElementById('lb-close').addEventListener('click', lbClose);
    document.getElementById('lb-prev').addEventListener('click', function() { lbShow(lbIdx - 1); });
    document.getElementById('lb-next').addEventListener('click', function() { lbShow(lbIdx + 1); });
    lbEl.addEventListener('click', function(e) { if (e.target === lbEl) lbClose(); });
    document.addEventListener('keydown', function(e) {
      if (lbEl.style.display !== 'flex') return;
      if (e.key === 'Escape') lbClose();
      if (e.key === 'ArrowRight') lbShow(lbIdx + 1);
      if (e.key === 'ArrowLeft')  lbShow(lbIdx - 1);
    });
  </script>
</body>

</html>