<!DOCTYPE html>
<html lang="<%= t.lang %>" dir="<%= t.dir %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= t.city_title %>
      <%= ciudad %> | Queens
  </title>
  <meta name="description" content="<%= t.city_title %> <%= ciudad %>. Queens.">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-velvet">

  <!-- Navbar -->
  <nav class="navbar">
    <a href="/inicio" class="navbar-logo" style="text-decoration:none">
      <img src="/img/queens-logo.png" alt="Queens" style="height:36px;"
        onerror="this.outerHTML='<span class=&quot;gold-shimmer&quot;>QUEENS</span>'">
    </a>
    <div class="navbar-links">
      <a href="/inicio">
        <%= t.city_back %>
      </a>
    </div>
  </nav>

  <div class="container" style="padding-top:100px;padding-bottom:60px;">
    <div id="recompensa-banner"
      style="position:sticky;top:70px;z-index:20;margin-bottom:12px;background:#111;border:1px solid #d5a03d;padding:10px 14px;border-radius:10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
      <span class="badge">Programa de afiliadas</span>
      <span style="flex:1;min-width:200px;">Trae anunciantes y gana días gratis: <strong>1</strong>→7 días ·
        <strong>3</strong>→15 días · <strong>5</strong>→30 días + Corona 👑</span>
      <button type="button" id="banner-close"
        style="background:none;border:none;color:#aaa;font-size:18px;cursor:pointer;">×</button>
    </div>

    <!-- City Header -->
    <div style="text-align:center;margin-bottom:40px;">
      <p class="section-title">
        <%= t.city_title %>
      </p>
      <h1 class="gold-shimmer font-cinzel" style="font-size:clamp(2rem,5vw,3.5rem);margin-bottom:8px;">
        <%= ciudad.toUpperCase() %>
      </h1>
    </div>

    <!-- Filter Bar -->
    <form id="geoForm" method="GET" action="/ciudad/<%= ciudad %>">
      <div class="filter-bar">
        <select name="categoria" class="filter-select auto-submit-select">
          <option value="">
            <%= t.city_filter_all %>
          </option>
          <option value="chica" <%=filters.categoria==='chica' ?'selected':'' %>><%= t.cat_chica %>
          </option>
          <option value="chico" <%=filters.categoria==='chico' ?'selected':'' %>><%= t.cat_chico %>
          </option>
          <option value="trans" <%=filters.categoria==='trans' ?'selected':'' %>><%= t.cat_trans %>
          </option>
        </select>
        <select name="disponibilidad" class="filter-select auto-submit-select">
          <option value="">Todas las disponibilidades</option>
          <option value="disponible" <%=filters.disponibilidad==='disponible' ?'selected':'' %>>🟢 Disponible ahora
          </option>
          <option value="proximamente" <%=filters.disponibilidad==='proximamente' ?'selected':'' %>>🟡 Próximamente
          </option>
          <option value="no_disponible" <%=filters.disponibilidad==='no_disponible' ?'selected':'' %>>🔴 No disponible
          </option>
        </select>
        <button type="submit" class="filter-btn">Buscar</button>
        <a href="/ciudad/<%= ciudad %>" style="font-size:0.75rem;color:var(--text-muted);padding:10px;">Limpiar
          filtros</a>
        <% let _cercLabel='Más cercanas' ; if (filters.categoria==='chica' ) _cercLabel='Chicas más cercanas' ; else if
          (filters.categoria==='chico' ) _cercLabel='Chicos más cercanos' ; else if (filters.categoria==='trans' )
          _cercLabel='Trans más cercanas' ; %>
          <button type="button" id="btn-cercanas" class="filter-btn" style="background:#0a8d54;">
            <%= _cercLabel %>
          </button>
          <input type="hidden" name="lat" value="<%= filters.lat || '' %>">
          <input type="hidden" name="lng" value="<%= filters.lng || '' %>">
          <input type="hidden" name="max_km" value="<%= filters.max_km || '' %>">
      </div>
    </form>

    <!-- 🟡 DESTACADAS 🟡 -->
    <% if (destacadas.length> 0) { %>
      <div class="tier-header">
        <span class="tier-badge destacada">👑 Destacadas</span>
      </div>
      <div class="profiles-grid highlighted">
        <% destacadas.forEach(p=> { %>
          <div class="dest-card" data-id="<%= p.id %>" data-fotos="<%- JSON.stringify(p.fotos) %>">
            <span class="card-plan-badge destacada"></span>
            <div class="availability-dot <%= p.disponibilidad %>"></div>

            <!-- Imagen con filo dorado -->
            <div class="dest-img-wrap">
              <% if (p.fotos.length > 0) { %>
                <img class="card-image dest-main-img" src="<%= p.fotos[0] %>" alt="<%= p.nombre %>" loading="lazy">
              <% } else { %>
                <div class="card-image-placeholder"><%= p.nombre.charAt(0).toUpperCase() %></div>
              <% } %>

              <!-- Flechas solo si hay >1 foto -->
              <% if (p.fotos.length > 1) { %>
              <button class="dest-arrow dest-prev" onclick="destNav(event,this,-1)" aria-label="Anterior">&#8249;</button>
              <button class="dest-arrow dest-next" onclick="destNav(event,this,+1)" aria-label="Siguiente">&#8250;</button>
              <div class="dest-dots">
                <% p.fotos.forEach((_, fi) => { %>
                <span class="dest-dot <%= fi===0?'active':'' %>"></span>
                <% }) %>
              </div>
              <% } %>

              <!-- Botón ampliar -->
              <button class="dest-expand" onclick="destExpand(event,this)" aria-label="Ampliar">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
              </button>
            </div>

            <!-- Info debajo de la imagen (fuera de la foto) -->
            <a href="/perfil/<%= p.id %>" class="dest-info">
              <div class="dest-name">
                <% if (p.nacionalidad) { %><img src="https://flagcdn.com/<%= p.nacionalidad %>.svg" alt="" style="width:16px;height:11px;border-radius:2px;vertical-align:middle;margin-right:4px;"><% } %>
                <%= p.nombre %>
              </div>
              <div class="dest-meta">
                <%= p.edad ? p.edad + ' años' : '' %><%= p.edad && p.zona ? ' · ' : '' %><%= p.zona || '' %>
                <% if (p.distancia !== undefined) { %> · <span style="color:#d4af37;">~<%= p.distancia %> km</span><% } %>
              </div>
            </a>
          </div>
          <% }) %>
      </div>
      <% } %>

        <!-- 🟡 BÁSICAS 🟡 -->
        <% if (basicas.length> 0) { %>
          <div class="tier-header">
            <span class="tier-badge basica">Catálogo</span>
          </div>
          <div class="profiles-grid basic-grid">
            <% basicas.forEach(p=> { %>
              <a href="/perfil/<%= p.id %>" class="profile-card">
                <div class="availability-dot <%= p.disponibilidad %>"></div>
                <% if (p.nacionalidad) { %>
                  <img src="https://flagcdn.com/<%= p.nacionalidad %>.svg" alt="<%= p.nacionalidad %>" style="position:absolute;top:8px;right:8px;width:24px;height:17px;border-radius:2px;z-index:2;box-shadow:0 1px 4px rgba(0,0,0,0.4);">
                <% } %>
                <% if (p.fotos.length> 0) { %>
                  <img class="card-image" src="<%= p.fotos[0] %>" alt="<%= p.nombre %>" loading="lazy">
                  <% } else { %>
                    <div class="card-image-placeholder" style="font-size:1.5rem">
                      <%= p.nombre.charAt(0).toUpperCase() %>
                    </div>
                    <% } %>
                      <div class="card-overlay">
                        <div class="card-name" style="font-size:0.9rem">
                          <% if (p.nacionalidad) { %><img src="https://flagcdn.com/<%= p.nacionalidad %>.svg" alt="" style="width:16px;height:11px;border-radius:2px;vertical-align:middle;margin-right:3px;"><% } %>
                          <%= p.nombre %>
                        </div>
                        <div class="card-meta">
                          <%= p.edad ? p.edad + ' años' : '' %><%= p.edad && p.zona ? ' · ' : '' %><%= p.zona || '' %>
                        </div>
                        <% if (p.distancia !==undefined) { %>
                          <div class="badge" style="margin-top:6px;">A <%= p.distancia %> km</div>
                          <% } %>
                      </div>
              </a>
              <% }) %>
          </div>
          <% } %>

            <!-- 🟡 AGENCIAS 🟡 -->
            <% if (agencias.length> 0) { %>
              <div class="tier-header">
                <span class="tier-badge basica">🏢 Agencias y Chalets</span>
              </div>
              <% agencias.forEach(a=> { %>
                <div class="agency-card">
                  <h3 class="gold-text font-cinzel-sm" style="font-size:1.1rem;margin-bottom:6px;">
                    <%= a.nombre %>
                  </h3>
                  <p class="text-muted mb-2">
                    <%= a.descripcion || '' %>
                  </p>
                  <% if (a.contacto) { %>
                    <a href="https://wa.me/<%= a.contacto.replace(/\D/g,'') %>" target="_blank"
                      class="btn btn-success btn-sm">
                      📱 Contactar por WhatsApp
                    </a>
                    <% } %>
                </div>
                <% }) %>
                  <% } %>


  </div>


  <!-- Ghost mode -->
  <a href="/ghost" class="ghost-trigger">● MODO SEGURO</a>

  <script src="/js/main.js"></script>
  <script>
    const btn = document.getElementById("btn-cercanas");
    if (btn) {
      btn.addEventListener("click", () => {
        if (!navigator.geolocation) return alert("Activa la ubicación");
        var GEO_KEY = 'queens_geo_consent';
        function doGeo() {
          localStorage.setItem(GEO_KEY, '1');
          navigator.geolocation.getCurrentPosition(pos => {
            document.querySelector("input[name=\"lat\"]").value = pos.coords.latitude.toFixed(5);
            document.querySelector("input[name=\"lng\"]").value = pos.coords.longitude.toFixed(5);
            document.querySelector("input[name=\"max_km\"]").value = 50;
            document.getElementById("geoForm").submit();
          }, () => alert("No pudimos obtener tu ubicación"));
        }
        if (localStorage.getItem(GEO_KEY) === '1') { doGeo(); }
        else if (confirm('📍 ¿Permitir acceder a tu ubicación para mostrarte perfiles cercanos?\n\nSe usa solo para calcular distancia. Datos anonimizados, máx. 90 días.\nMás info en /legal/privacidad')) { doGeo(); }
        else { localStorage.setItem(GEO_KEY, '0'); }
      });
    }
    const banner = document.getElementById("recompensa-banner");
    const closeBtn = document.getElementById("banner-close");
    if (banner && closeBtn) closeBtn.addEventListener("click", () => banner.style.display = "none");

    // ── Tarjetas destacadas: flechas + ampliar ────────────
    (function() {
      // Navegar entre fotos con flechas
      window.destNav = function(e, btn, dir) {
        e.preventDefault(); e.stopPropagation();
        const card  = btn.closest('.dest-card');
        const fotos = JSON.parse(card.dataset.fotos || '[]');
        if (fotos.length < 2) return;
        const img   = card.querySelector('.dest-main-img');
        const dots  = card.querySelectorAll('.dest-dot');
        let idx = parseInt(card.dataset.idx || '0') + dir;
        idx = ((idx % fotos.length) + fotos.length) % fotos.length;
        card.dataset.idx = idx;
        img.style.opacity = '0';
        img.style.transition = 'opacity 0.25s';
        setTimeout(() => { img.src = fotos[idx]; img.style.opacity = '1'; }, 150);
        dots.forEach((d, j) => d.classList.toggle('active', j === idx));
      };

      // Ampliar foto actual en lightbox
      window.destExpand = function(e, btn) {
        e.preventDefault(); e.stopPropagation();
        const card  = btn.closest('.dest-card');
        const fotos = JSON.parse(card.dataset.fotos || '[]');
        const idx   = parseInt(card.dataset.idx || '0');
        const id    = card.dataset.id;
        if (!fotos.length) return;
        // Abrir lightbox inline
        let lb = document.getElementById('dest-lb');
        if (!lb) {
          lb = document.createElement('div');
          lb.id = 'dest-lb';
          lb.style.cssText = 'position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.97);display:flex;align-items:center;justify-content:center;flex-direction:column;';
          lb.innerHTML = `
            <button onclick="this.closest('#dest-lb').remove();document.body.style.overflow=''"
              style="position:fixed;top:14px;right:18px;background:none;border:none;color:#aaa;font-size:2.2rem;cursor:pointer;z-index:10001;">✕</button>
            <button id="dest-lb-prev" style="position:fixed;top:50%;left:14px;transform:translateY(-50%);background:rgba(0,0,0,0.5);border:1px solid rgba(212,175,55,0.4);color:#f9e27e;font-size:2rem;width:46px;height:46px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;">&#8249;</button>
            <button id="dest-lb-next" style="position:fixed;top:50%;right:14px;transform:translateY(-50%);background:rgba(0,0,0,0.5);border:1px solid rgba(212,175,55,0.4);color:#f9e27e;font-size:2rem;width:46px;height:46px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;">&#8250;</button>
            <img id="dest-lb-img" style="max-width:92vw;max-height:85vh;object-fit:contain;border-radius:10px;opacity:0;transition:opacity 0.3s;">
            <div id="dest-lb-ctr" style="margin-top:12px;font-size:0.72rem;color:rgba(212,175,55,0.7);letter-spacing:2px;"></div>`;
          document.body.appendChild(lb);
          lb.addEventListener('click', e => { if (e.target === lb) { lb.remove(); document.body.style.overflow=''; }});
          document.addEventListener('keydown', function esc(e) {
            if (e.key==='Escape'){ lb.remove(); document.body.style.overflow=''; document.removeEventListener('keydown',esc); }
            if (e.key==='ArrowRight') lbNav(1);
            if (e.key==='ArrowLeft')  lbNav(-1);
          });
        }
        document.body.style.overflow = 'hidden';
        let lbIdx = idx;
        const lbImg = lb.querySelector('#dest-lb-img');
        const lbCtr = lb.querySelector('#dest-lb-ctr');
        function lbShow(i) {
          lbIdx = ((i%fotos.length)+fotos.length)%fotos.length;
          lbImg.style.opacity='0';
          setTimeout(()=>{ lbImg.src=fotos[lbIdx]; lbImg.onload=()=>lbImg.style.opacity='1'; if(lbImg.complete)lbImg.style.opacity='1'; },120);
          lbCtr.textContent=`${lbIdx+1} / ${fotos.length}`;
        }
        function lbNav(d){ lbShow(lbIdx+d); }
        lb.querySelector('#dest-lb-prev').onclick = e=>{ e.stopPropagation(); lbNav(-1); };
        lb.querySelector('#dest-lb-next').onclick = e=>{ e.stopPropagation(); lbNav(1); };
        lbShow(idx);
      };
    })();
  </script>
</body>

</html>