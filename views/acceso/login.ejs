<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Acceso | Queens Escort</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-velvet">
  <div class="container" style="padding-top:120px;max-width:520px;">
    <h1 class="gold-shimmer font-cinzel" style="text-align:center;margin-bottom:24px;">Acceso privado</h1>
    <% if (error) { %>
      <div class="alert alert-danger" style="margin-bottom:16px;">
        <%= error %>
      </div>
      <% } %>
        <form method="POST" action="/acceso/login" class="card"
          style="padding:24px;border-radius:12px;background:#111;">
          <label>Email</label>
          <input class="input" type="email" name="email" required>
          <label style="margin-top:12px;">Contraseña</label>
          <input class="input" type="password" name="password" required>
          <button type="submit" class="btn-gold" style="width:100%;margin-top:16px;">Entrar</button>
        </form>
        <p style="margin-top:12px;text-align:center;color:#aaa;">¿No tienes cuenta? <a href="/acceso/registro">Solicitar
            alta</a></p>
  </div>
  <script src="/js/main.js?v=<%= v %>"></script>
</body>

</html>