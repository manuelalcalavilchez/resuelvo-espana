<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Solicitar acceso | Queens Escort</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-velvet">
  <div class="container" style="padding-top:120px;max-width:620px;">
    <h1 class="gold-shimmer font-cinzel" style="text-align:center;margin-bottom:24px;">Solicitar acceso</h1>
    <% if (error) { %>
      <div class="alert alert-danger" style="margin-bottom:16px;"> <%= error %> </div>
    <% } %>
    <form method="POST" action="/acceso/registro" class="card" style="padding:24px;border-radius:12px;background:#111;">
      <label>Email</label>
      <input class="input" type="email" name="email" required>
      <label style="margin-top:12px;">Contraseña</label>
      <input class="input" type="password" name="password" required>
      <label style="margin-top:12px;">Rol</label>
      <select class="input" name="rol">
        <option value="agencia">Agencia</option>
        <option value="modelo">Modelo independiente</option>
      </select>
      <label style="margin-top:12px;">Agencia (si aplica)</label>
      <select class="input" name="agencia_id">
        <option value="">--</option>
        <% agencias.forEach(a => { %>
          <option value="<%= a.id %>"><%= a.nombre %> (<%= a.ciudad %>)</option>
        <% }) %>
      </select>
      <button type="submit" class="btn-gold" style="width:100%;margin-top:16px;">Enviar</button>
    </form>
    <p style="margin-top:12px;text-align:center;color:#aaa;">¿Ya tienes cuenta? <a href="/acceso/login">Entrar</a></p>
  </div>
</body>
</html>

