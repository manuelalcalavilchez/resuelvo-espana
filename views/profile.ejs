<!DOCTYPE html>
<html lang="<%= t.lang %>" dir="<%= t.dir %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= perfil.nombre %> — Queens <%= perfil.ciudad %></title>
  <meta name="description" content="<%= perfil.nombre %> — <%= t.city_title %> <%= perfil.ciudad %>.">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-velvet">

  <nav class="navbar">
    <a href="/inicio" class="navbar-logo" style="text-decoration:none">
      <img src="/img/queens-logo.png" alt="Queens" style="height:36px;" onerror="this.outerHTML='<span class=&quot;gold-shimmer&quot;>QUEENS</span>'">
    </a>
    <div class="navbar-links">
      <a href="/ciudad/<%= perfil.ciudad %>">← <%= perfil.ciudad %></a>
    </div>
  </nav>

  <div class="container" style="padding-top:100px;padding-bottom:60px;">
    <div class="profile-detail-grid">

      <!-- Photo Gallery -->
      <div class="photo-gallery" style="position:relative;">
        <% if (perfil.fotos.length > 0) { %>
          <%
            const fotosPublicas = perfil.fotos;
            const pixelar = perfil.pixelar_cara === true;
          %>
          <!-- Foto portada → clic abre lightbox -->
          <div class="photo-main-wrap" id="gallery-main-wrap" onclick="qlbOpen(0)" title="Ver fotos">
            <img id="main-photo" class="photo-main" style="margin-bottom:0;" src="<%= fotosPublicas[0] %>" alt="<%= perfil.nombre %>" crossorigin="anonymous">

            <!-- Badges info -->
            <div style="position:absolute;bottom:12px;left:12px;display:flex;gap:6px;flex-wrap:wrap;z-index:3;">
              <% if (perfil.nacionalidad) { %>
              <span style="display:inline-flex;align-items:center;gap:4px;background:rgba(0,0,0,0.72);padding:4px 10px;border-radius:20px;font-size:0.75rem;color:#fff;backdrop-filter:blur(4px);">
                <img src="https://flagcdn.com/<%= perfil.nacionalidad %>.svg" alt="" style="width:18px;height:13px;border-radius:2px;">
              </span>
              <% } %>
              <% if (perfil.edad) { %>
              <span style="display:inline-flex;align-items:center;background:rgba(0,0,0,0.72);padding:4px 10px;border-radius:20px;font-size:0.75rem;color:#fff;backdrop-filter:blur(4px);">
                <%= perfil.edad %> años
              </span>
              <% } %>
              <% if (perfil.zona) { %>
              <span style="display:inline-flex;align-items:center;background:rgba(0,0,0,0.72);padding:4px 10px;border-radius:20px;font-size:0.75rem;color:#fff;backdrop-filter:blur(4px);">
                📍 <%= perfil.zona %><span id="dist-photo" style="margin-left:4px;color:#d4af37;"></span>
              </span>
              <% } %>
            </div>

            <!-- Indicador de fotos (esquina superior derecha) -->
            <% if (fotosPublicas.length > 1) { %>
            <div style="position:absolute;top:10px;right:10px;z-index:3;display:flex;align-items:center;gap:5px;background:rgba(0,0,0,0.72);padding:5px 11px;border-radius:20px;backdrop-filter:blur(4px);">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="2.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
              <span style="font-size:0.72rem;color:#f9e27e;font-weight:600;"><%= fotosPublicas.length %> fotos</span>
            </div>
            <% } %>

            <!-- Hint "toca para ver" solo con >1 foto -->
            <% if (fotosPublicas.length > 1) { %>
            <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.3s;z-index:2;" class="gallery-hover-hint">
              <div style="background:rgba(0,0,0,0.55);padding:10px 18px;border-radius:30px;border:1px solid rgba(212,175,55,0.5);color:#f9e27e;font-size:0.78rem;letter-spacing:1px;backdrop-filter:blur(6px);">
                Ver todas las fotos
              </div>
            </div>
            <% } %>
          </div>

          <!-- Tira de miniaturas (todas las fotos, todos los planes) -->
          <% if (fotosPublicas.length > 1) { %>
          <div class="photo-thumbs" style="margin-top:10px;">
            <% fotosPublicas.forEach((foto, i) => { %>
              <div style="position:relative;overflow:hidden;border-radius:var(--radius-sm);cursor:pointer;border:2px solid <%= i===0 ? '#d4af37' : 'rgba(212,175,55,0.15)' %>;" onclick="qlbOpen(<%= i %>)" class="thumb-item">
                <img class="photo-thumb" src="<%= foto %>" data-idx="<%= i %>" alt="Foto <%= i+1 %>" style="margin:0;width:100%;aspect-ratio:1;object-fit:cover;display:block;transition:transform 0.25s;" crossorigin="anonymous">
              </div>
            <% }) %>
          </div>
          <% } %>

        <% } else { %>
          <div class="card-image-placeholder" style="border-radius:14px;border:1px solid rgba(212,175,55,0.3);font-size:4rem;color:var(--gold-3);aspect-ratio:3/4;">
            <%= perfil.nombre.charAt(0).toUpperCase() %>
          </div>
        <% } %>

        <!-- ── LIGHTBOX OVERLAY ─────────────────────────── -->
        <% if (perfil.fotos.length > 0) { %>
        <div id="qlb" class="qlb-overlay" role="dialog" aria-modal="true" onclick="if(event.target===this)qlbClose()">
          <button class="qlb-close" onclick="qlbClose()" aria-label="Cerrar">✕</button>
          <% if (perfil.fotos.length > 1) { %>
          <button class="qlb-arrow left" onclick="qlbPrev()" aria-label="Anterior">‹</button>
          <button class="qlb-arrow right" onclick="qlbNext()" aria-label="Siguiente">›</button>
          <% } %>
          <div class="qlb-img-wrap" id="qlb-img-wrap">
            <img id="qlb-img" class="qlb-img" src="" alt="" crossorigin="anonymous">
          </div>
          <div class="qlb-counter" id="qlb-counter"></div>
          <% if (perfil.fotos.length > 1) { %>
          <div class="qlb-dots" id="qlb-dots">
            <% perfil.fotos.forEach((_, i) => { %>
              <div class="qlb-dot <%= i===0?'active':'' %>" onclick="qlbGo(<%= i %>)"></div>
            <% }) %>
          </div>
          <% } %>
        </div>
        <% } %>

        <!-- Vídeo de presentación (solo Destacada) -->
        <% if (perfil.plan === 'destacada' && perfil.video) { %>
          <div style="margin-top:16px;position:relative;border-radius:14px;overflow:hidden;border:1px solid rgba(212,175,55,0.4);box-shadow:0 0 30px rgba(212,175,55,0.12);">
            <div style="position:absolute;top:10px;left:10px;z-index:2;background:linear-gradient(135deg,#7a5c00,#d4af37);color:#000;font-size:0.65rem;font-weight:700;padding:4px 10px;border-radius:20px;letter-spacing:1px;">
              👑 VÍDEO EXCLUSIVO
            </div>
            <video src="<%= perfil.video %>" controls playsinline preload="metadata" style="width:100%;display:block;background:#000;"></video>
          </div>
        <% } %>

        <!-- Verified badge -->
        <div style="margin-top:16px;display:flex;align-items:center;gap:10px;padding:14px 18px;background:rgba(0,230,118,0.05);border:1px solid rgba(0,230,118,0.2);border-radius:10px;">
          <span style="font-size:1.2rem;">✅</span>
          <div>
            <div style="font-size:0.75rem;font-weight:700;color:#00e676;letter-spacing:1px;">PERFIL VERIFICADO</div>
            <div style="font-size:0.65rem;color:var(--text-muted);">Identidad y fotos comprobadas por Queens</div>
          </div>
        </div>
      </div>

      <!-- Profile Info -->
      <div>
        <!-- Plan badge -->
        <% if (perfil.plan === 'destacada') { %>
        <div style="margin-bottom:16px;">
          <span class="badge badge-destacada" style="font-size:0.7rem;padding:5px 16px;background:linear-gradient(135deg,#7a5c00,#d4af37);color:#000;">
            👑 PERFIL DESTACADO
          </span>
        </div>
        <% } %>

        <div class="profile-info-card">
          <h1 class="profile-name-big gold-text font-cinzel"><%= perfil.nombre %></h1>
          
          <div style="display:flex;align-items:center;gap:16px;margin:12px 0;">
            <span class="availability-badge <%= perfil.disponibilidad %>">
              <span style="width:8px;height:8px;border-radius:50%;background:currentColor;flex-shrink:0;"></span>
              <%= perfil.disponibilidad === 'disponible' ? 'Disponible' : perfil.disponibilidad === 'no_disponible' ? 'No disponible' : 'Próximamente' %>
            </span>
          </div>

          <div class="profile-tags">
            <span class="tag">📍 <%= perfil.ciudad %></span>
            <% if (perfil.edad) { %><span class="tag">🎂 <%= perfil.edad %> años</span><% } %>
            <span class="tag">
              <%= perfil.categoria === 'chica' ? '♀ Chica' : perfil.categoria === 'chico' ? '♂ Chico' : '⚧ Trans' %>
            </span>
            <% if (perfil.idiomas) { %><span class="tag">🌐 <%= perfil.idiomas %></span><% } %>
            <span class="tag">#️⃣ <%= perfil.id %></span>
          </div>

          <% if (perfil.descripcion && perfil.descripcion.trim().length > 0) { %>
          <div style="margin-top:22px;padding:18px 20px;background:rgba(212,175,55,0.04);border:1px solid rgba(212,175,55,0.18);border-left:3px solid #d4af37;border-radius:10px;">
            <p style="font-size:0.7rem;font-weight:700;letter-spacing:1.5px;color:#d4af37;margin-bottom:10px;text-transform:uppercase;">Sobre mí</p>
            <p style="font-size:0.92rem;color:#e8eef5;line-height:1.75;white-space:pre-line;margin:0;"><%= perfil.descripcion %></p>
          </div>
          <% } %>

          <% 
            var telDigits = (perfil.telefono || '').replace(/\D/g, '');
            var telHref = '';
            if (telDigits) {
              if (telDigits.length === 9) telHref = 'tel:+34' + telDigits;
              else telHref = 'tel:+' + telDigits;
            }
          %>
          <!-- Contacto: WhatsApp + llamada (trackeado) -->
          <div class="contact-actions">
            <a id="btn-wa" href="/perfil/<%= perfil.id %>/contacto?tipo=whatsapp" target="_blank" rel="noopener noreferrer" class="contact-btn">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="white" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              WhatsApp
            </a>
            <% if (telHref) { %>
            <a id="btn-tel" href="/perfil/<%= perfil.id %>/contacto?tipo=telefono" class="contact-btn contact-btn--phone">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              Llamar
            </a>
            <% } %>
          </div>
          <button type="button" id="btn-referral" class="contact-btn" style="background:#111;border:1px dashed #d5a03d;color:#d5a03d;margin-top:4px;">Invita a nuevos anunciantes y obtén tu recompensa</button>
        </div>

        <!-- Info table -->
        <div class="profile-info-card mt-2">
          <p class="section-title">Información</p>
          <table style="width:100%;font-size:0.83rem;">
            <% if (perfil.edad) { %>
            <tr style="border-bottom:1px solid rgba(212,175,55,0.1)">
              <td style="padding:10px 0;color:var(--text-muted);">Edad</td>
              <td style="padding:10px 0;text-align:right;"><%= perfil.edad %> años</td>
            </tr>
            <% } %>
            <tr style="border-bottom:1px solid rgba(212,175,55,0.1)">
              <td style="padding:10px 0;color:var(--text-muted);">Ciudad</td>
              <td style="padding:10px 0;text-align:right;"><%= perfil.ciudad %></td>
            </tr>
            <% if (perfil.zona) { %>
            <tr style="border-bottom:1px solid rgba(212,175,55,0.1)">
              <td style="padding:10px 0;color:var(--text-muted);">Zona</td>
              <td style="padding:10px 0;text-align:right;"><%= perfil.zona %><span id="dist-badge" style="display:none;margin-left:6px;font-size:0.7rem;color:#d4af37;"></span></td>
            </tr>
            <% } %>
            <tr style="border-bottom:1px solid rgba(212,175,55,0.1)">
              <td style="padding:10px 0;color:var(--text-muted);">Categoría</td>
              <td style="padding:10px 0;text-align:right;text-transform:capitalize;"><%= perfil.categoria %></td>
            </tr>
            <% if (perfil.idiomas) { %>
            <tr style="border-bottom:1px solid rgba(212,175,55,0.1)">
              <td style="padding:10px 0;color:var(--text-muted);">Idiomas</td>
              <td style="padding:10px 0;text-align:right;"><%= perfil.idiomas %></td>
            </tr>
            <% } %>
            <tr>
              <td style="padding:10px 0;color:var(--text-muted);">ID Perfil</td>
              <td style="padding:10px 0;text-align:right;color:var(--gold-2);font-family:'Cinzel',serif;"><%= perfil.id %></td>
            </tr>
          </table>
        </div>
      </div>
    </div>

    <!-- Related Profiles -->
    <% if (relacionados.length > 0) { %>
    <div style="margin-top:60px;">
      <div class="tier-header">
        <span class="tier-badge basica">También en <%= perfil.ciudad %></span>
      </div>
      <div class="profiles-grid basic-grid">
        <% relacionados.forEach(r => { %>
          <a href="/perfil/<%= r.id %>" class="profile-card">
            <div class="availability-dot <%= r.disponibilidad %>"></div>
            <% if ((r.fotos || []).length > 0) { %>
              <img class="card-image" src="<%= r.fotos[0] %>" alt="<%= r.nombre %>" loading="lazy">
            <% } else { %>
              <div class="card-image-placeholder" style="font-size:1.5rem"><%= r.nombre.charAt(0).toUpperCase() %></div>
            <% } %>
            <div class="card-overlay">
              <div class="card-name" style="font-size:0.9rem"><%= r.nombre %></div>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>

  <!-- Banner consentimiento ubicación (RGPD) -->
  <div id="geo-consent-banner" style="display:none;position:fixed;bottom:12px;left:12px;right:12px;z-index:9998;background:rgba(8,14,28,0.96);border:1px solid rgba(212,175,55,0.4);border-radius:14px;box-shadow:0 12px 40px rgba(0,0,0,0.55);backdrop-filter:blur(8px);padding:14px 18px;animation:cookieSlideUp 0.4s ease;">
    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:14px;max-width:1100px;margin:0 auto;">
      <div style="flex:1 1 320px;color:#e8eef5;font-size:0.82rem;line-height:1.55;">
        <strong style="color:#f9e27e;">📍 Ubicación</strong>
        ¿Quieres ver la distancia aproximada a este perfil? Usaremos tu ubicación solo para calcular la distancia. Los datos se guardan de forma anónima durante 90 días máximo.
        <a href="/legal/privacidad" style="color:#d4af37;">Más info</a>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;">
        <button type="button" id="geo-consent-yes" style="display:inline-block;padding:9px 18px;border-radius:9px;font-size:0.8rem;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;cursor:pointer;border:1px solid #d4af37;background:linear-gradient(135deg,#7a5c00,#d4af37);color:#0a0a0a;font-family:inherit;">Permitir</button>
        <button type="button" id="geo-consent-no" style="display:inline-block;padding:9px 18px;border-radius:9px;font-size:0.8rem;font-weight:700;cursor:pointer;border:1px solid rgba(200,210,220,0.3);background:transparent;color:rgba(200,210,220,0.85);font-family:inherit;">No, gracias</button>
      </div>
    </div>
  </div>

  <a href="/ghost" class="ghost-trigger">● MODO SEGURO</a>
  <script src="/js/main.js"></script>
  <script>
    // Geolocalización del visitante (con consentimiento RGPD)
    (function() {
      if (!navigator.geolocation) return;
      // Solo pedir GPS si el usuario ya consintió o tras aceptar
      var GEO_KEY = 'queens_geo_consent';
      function onPosition(pos) {
        var lat1 = pos.coords.latitude, lng1 = pos.coords.longitude;

        // Añadir coordenadas a los links de contacto para tracking
        ['btn-wa', 'btn-tel'].forEach(function(id) {
          var el = document.getElementById(id);
          if (el) el.href += '&vlat=' + lat1.toFixed(5) + '&vlng=' + lng1.toFixed(5);
        });

        <% if (perfil.zona_lat && perfil.zona_lng) { %>
        // Calcular distancia a la zona del perfil
        var lat2 = <%= perfil.zona_lat %>, lng2 = <%= perfil.zona_lng %>;
        var R = 6371;
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLng = (lng2 - lng1) * Math.PI / 180;
        var a = Math.sin(dLat/2)*Math.sin(dLat/2) +
                Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*
                Math.sin(dLng/2)*Math.sin(dLng/2);
        var d = R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        var txt = '~' + (d < 1 ? Math.round(d*1000) + ' m' : d.toFixed(1) + ' km');
        var badge = document.getElementById('dist-badge');
        if (badge) { badge.textContent = txt; badge.style.display = 'inline'; }
        var photo = document.getElementById('dist-photo');
        if (photo) { photo.textContent = txt; }
        <% } %>
      }
      if (localStorage.getItem(GEO_KEY) === '1') {
        navigator.geolocation.getCurrentPosition(onPosition, function(){}, { timeout: 5000 });
      } else if (localStorage.getItem(GEO_KEY) !== '0') {
        // Mostrar banner de consentimiento
        var banner = document.getElementById('geo-consent-banner');
        if (banner) {
          banner.style.display = 'block';
          document.getElementById('geo-consent-yes').addEventListener('click', function() {
            localStorage.setItem(GEO_KEY, '1');
            banner.style.display = 'none';
            navigator.geolocation.getCurrentPosition(onPosition, function(){}, { timeout: 5000 });
          });
          document.getElementById('geo-consent-no').addEventListener('click', function() {
            localStorage.setItem(GEO_KEY, '0');
            banner.style.display = 'none';
          });
        }
      }
    })();

    const refBtn = document.getElementById('btn-referral');
    if (refBtn) {
      refBtn.addEventListener('click', () => {
        const url = `${window.location.origin}/inicio?ref=<%= perfil.id %>`;
        navigator.clipboard.writeText(url).then(() => { refBtn.textContent = 'Enlace copiado'; setTimeout(()=>refBtn.textContent='Invita a nuevos anunciantes y obtén tu recompensa',2000); });
      });
    }
  </script>

  <!-- ── LIGHTBOX + PIXELACIÓN DE CARA ────────────────── -->
  <% if (perfil.fotos && perfil.fotos.length > 0) { %>
  <% if (perfil.pixelar_cara) { %>
  <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
  <% } %>
  <script>
    const FOTOS_LB = <%- JSON.stringify(perfil.fotos) %>;
    const PIXELAR  = <%= perfil.pixelar_cara ? 'true' : 'false' %>;
    let qlbIdx = 0;
    let touchStartX = 0;
    const faceCache = {}; // url → [{x,y,w,h}] relativo (0-1)

    // ── Lightbox ──────────────────────────────────────────
    function qlbOpen(i) {
      qlbIdx = i;
      document.getElementById('qlb').classList.add('open');
      document.body.style.overflow = 'hidden';
      qlbShow(i);
    }
    function qlbClose() {
      document.getElementById('qlb').classList.remove('open');
      document.body.style.overflow = '';
    }
    function qlbNext() { qlbIdx = (qlbIdx + 1) % FOTOS_LB.length; qlbShow(qlbIdx); }
    function qlbPrev() { qlbIdx = (qlbIdx - 1 + FOTOS_LB.length) % FOTOS_LB.length; qlbShow(qlbIdx); }
    function qlbGo(i)  { qlbIdx = i; qlbShow(i); }

    function qlbShow(i) {
      const img = document.getElementById('qlb-img');
      img.classList.remove('visible');

      // Quitar canvas anterior de pixelado
      const wrap = document.getElementById('qlb-img-wrap');
      wrap.querySelectorAll('canvas').forEach(c => c.remove());

      img.onload = () => {
        img.classList.add('visible');
        if (PIXELAR) applyPixelCanvas(wrap, img);
      };
      img.src = FOTOS_LB[i];
      if (img.complete && img.naturalWidth) { img.classList.add('visible'); if (PIXELAR) applyPixelCanvas(wrap, img); }

      // Contador
      const ctr = document.getElementById('qlb-counter');
      if (ctr) ctr.textContent = `${i + 1} / ${FOTOS_LB.length}`;

      // Dots
      document.querySelectorAll('.qlb-dot').forEach((d, j) => d.classList.toggle('active', j === i));
    }

    // ── Teclado y swipe ───────────────────────────────────
    document.addEventListener('keydown', e => {
      if (!document.getElementById('qlb').classList.contains('open')) return;
      if (e.key === 'Escape')      qlbClose();
      if (e.key === 'ArrowRight')  qlbNext();
      if (e.key === 'ArrowLeft')   qlbPrev();
    });
    document.getElementById('qlb').addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
    document.getElementById('qlb').addEventListener('touchend',   e => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 50) dx < 0 ? qlbNext() : qlbPrev();
    });

    // ── Pixelación de cara con face-api.js ───────────────
    <% if (perfil.pixelar_cara) { %>
    async function getFaces(imgEl) {
      const url = imgEl.src;
      if (faceCache[url] !== undefined) return faceCache[url];
      try {
        const dets = await faceapi.detectAllFaces(
          imgEl,
          new faceapi.TinyFaceDetectorOptions({ inputSize: 224, scoreThreshold: 0.3 })
        );
        faceCache[url] = dets.map(d => ({
          x: d.box.x / imgEl.naturalWidth,
          y: d.box.y / imgEl.naturalHeight,
          w: d.box.width  / imgEl.naturalWidth,
          h: d.box.height / imgEl.naturalHeight
        }));
      } catch(_) { faceCache[url] = []; }
      return faceCache[url];
    }

    function drawPixel(canvas, imgEl, faces) {
      canvas.width  = imgEl.offsetWidth  || imgEl.naturalWidth;
      canvas.height = imgEl.offsetHeight || imgEl.naturalHeight;
      if (!canvas.width || !canvas.height || !faces.length) return;
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      faces.forEach(f => {
        const pad = 0.25;
        const x  = (f.x - f.w * pad) * canvas.width;
        const y  = (f.y - f.h * pad) * canvas.height;
        const w  = f.w * (1 + pad * 2) * canvas.width;
        const h  = f.h * (1 + pad * 2) * canvas.height;
        const px = Math.max(0, x), py = Math.max(0, y);
        const pw = Math.min(canvas.width  - px, w);
        const ph = Math.min(canvas.height - py, h);

        // Coordenadas en imagen natural
        const sx = (px / canvas.width)  * imgEl.naturalWidth;
        const sy = (py / canvas.height) * imgEl.naturalHeight;
        const sw = (pw / canvas.width)  * imgEl.naturalWidth;
        const sh = (ph / canvas.height) * imgEl.naturalHeight;

        // Pixelar: reducir a bloque pequeño y escalar sin suavizado
        const PSIZE = 14;
        const tmp = document.createElement('canvas');
        tmp.width  = Math.max(1, Math.round(pw / PSIZE));
        tmp.height = Math.max(1, Math.round(ph / PSIZE));
        const tc = tmp.getContext('2d');
        tc.imageSmoothingEnabled = false;
        tc.drawImage(imgEl, sx, sy, sw, sh, 0, 0, tmp.width, tmp.height);
        ctx.imageSmoothingEnabled = false;
        ctx.drawImage(tmp, 0, 0, tmp.width, tmp.height, px, py, pw, ph);
      });
    }

    function applyPixelCanvas(container, imgEl) {
      let canvas = container.querySelector('canvas.face-pixel');
      if (!canvas) {
        canvas = document.createElement('canvas');
        canvas.className = 'face-pixel';
        canvas.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:3;border-radius:inherit;';
        container.appendChild(canvas);
      }
      getFaces(imgEl).then(faces => drawPixel(canvas, imgEl, faces));
    }

    // Inicializar face-api y aplicar a galería
    faceapi.nets.tinyFaceDetector.loadFromUri('/models/tiny_face_detector').then(() => {
      // Foto principal
      const mainWrap = document.getElementById('gallery-main-wrap');
      const mainImg  = document.getElementById('main-photo');
      if (mainWrap && mainImg) {
        if (mainImg.complete && mainImg.naturalWidth) applyPixelCanvas(mainWrap, mainImg);
        else mainImg.addEventListener('load', () => applyPixelCanvas(mainWrap, mainImg));
        new ResizeObserver(() => getFaces(mainImg).then(f => {
          const c = mainWrap.querySelector('canvas.face-pixel');
          if (c) drawPixel(c, mainImg, f);
        })).observe(mainWrap);
      }

      // Miniaturas
      document.querySelectorAll('.photo-thumb').forEach(img => {
        const wrap = img.parentElement;
        if (img.complete && img.naturalWidth) applyPixelCanvas(wrap, img);
        else img.addEventListener('load', () => applyPixelCanvas(wrap, img));
      });
    });
    <% } else { %>
    function applyPixelCanvas() {}  // no-op si pixelar desactivado
    <% } %>
  </script>
  <% } %>
</body>
</html>








