<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login — Queens</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="login-container">
    <div class="login-card">
      <div style="font-size:2rem;margin-bottom:12px;">👑</div>
      <h1>QUEENS</h1>
      <p>Panel de Administración</p>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form action="/admin/login" method="POST">
        <div style="margin-bottom:16px;text-align:left;">
          <label class="admin-form-label">Contraseña de acceso</label>
          <input type="password" name="password" class="admin-form-input" placeholder="••••••••••" autofocus required>
        </div>
        <button type="submit" class="btn btn-primary w-100" style="justify-content:center;padding:12px;">
          Acceder al Panel →
        </button>
      </form>

      <p style="margin-top:20px;font-size:0.65rem;color:#2a3450;">Acceso restringido al equipo interno de Queens</p>
    </div>
  </div>
</body>
</html>
