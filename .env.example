# Variables de entorno de ejemplo. Configurar los valores reales en Easypanel.
NODE_ENV=production
PORT=3000
RESUELVO_DATA_DIR=/app/data
ADMIN_PASSWORD=REEMPLAZAR_POR_UNA_CONTRASENA_UNICA_Y_LARGA
SESSION_SECRET=REEMPLAZAR_POR_64_CARACTERES_ALEATORIOS
# URL pública sin barra final (canonical, sitemap y retorno de Stripe)
PUBLIC_BASE_URL=https://tu-dominio.es

# Datos del titular para aviso legal y privacidad
LEGAL_TITULAR=
LEGAL_NIF=
LEGAL_DOMICILIO=
LEGAL_EMAIL=

# Pagos con Stripe (la recarga de créditos se activa solo si existen ambas)
# Webhook: https://tu-dominio.es/servicios/pagos/webhook  (evento checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Factura automática de Stripe en cada recarga (1 = activada; Stripe cobra por factura)
STRIPE_INVOICES=

# Email (avisos a profesionales, al administrador y recuperación de contraseña)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ayuda en el Barrio <no-reply@tu-dominio.es>"
ADMIN_EMAIL=

# Webhook de eventos (n8n, Evolution API/WhatsApp…). Cabecera x-ayuda-signature = sha256=HMAC(body)
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
