# Variables de entorno de ejemplo. Configurar los valores reales en Easypanel.
NODE_ENV=production
PORT=3000
RESUELVO_DATA_DIR=/app/data
ADMIN_PASSWORD=REEMPLAZAR_POR_UNA_CONTRASENA_UNICA_Y_LARGA
SESSION_SECRET=REEMPLAZAR_POR_64_CARACTERES_ALEATORIOS
# URL pública sin barra final (canonical, sitemap y retorno de Stripe)
PUBLIC_BASE_URL=https://tu-dominio.es

# Datos del titular para aviso legal y privacidad
LEGAL_TITULAR=
LEGAL_NIF=
LEGAL_DOMICILIO=
LEGAL_EMAIL=

# Pagos con Stripe (la recarga de créditos se activa solo si existen ambas)
# Webhook: https://tu-dominio.es/servicios/pagos/webhook  (evento checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
